-- ฟังก์ชันกดปุ่มยืนยัน
SubmitBtn.MouseButton1Click:Connect(function()
    local inputKey = TextBox.Text
    if ValidKeys[inputKey] then
        local duration = ValidKeys[inputKey]
        local expireTime = (duration == -1) and -1 or (os.time() + duration)
        
        SaveData(inputKey, expireTime)
        ScreenGui:Destroy()
        RunMainScript(expireTime)
    else
        TextBox.Text = ""
        TextBox.PlaceholderText = "คีย์ไม่ถูกต้อง! ลองใหม่อีกครั้ง"
        task.delay(1.5, function()
            TextBox.PlaceholderText = "กรอกคีย์ของคุณที่นี่..."
        end)
    end
end)
